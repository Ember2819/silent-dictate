<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Silent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorHighlight">#40ECEDEF</item>
        <!-- one neutral accent everywhere (cursor, selection handles, ripples) -->
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/text_primary</item>
        <item name="colorControlNormal">@color/text_faint</item>
        <item name="colorControlActivated">@color/text_primary</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Button.Base" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Primary" parent="Button.Base">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
    </style>

    <style name="Button.Secondary" parent="Button.Base">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
    </style>

    <style name="Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
