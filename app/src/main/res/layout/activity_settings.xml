<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="32dp"
        android:paddingEnd="22dp"
        android:paddingBottom="48dp">

        <!-- ================== HEADER ================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="Silent Dictate"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Type like normal. Swipe left on the keyboard, hold the button, and mouth your words — no sound needed."
            android:textSize="15sp" />

        <!-- ================== SET UP ================== -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Set up" />

        <LinearLayout
            android:id="@+id/setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:id="@+id/try_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline" />

            <EditText
                android:id="@+id/try_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Tap here to try the keyboard"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="56dp"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ================== TRANSCRIPTION ================== -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Transcription" />

        <LinearLayout
            android:id="@+id/transcription_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/seg_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/seg_or"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/seg_or_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="OpenRouter"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/seg_or_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recommended"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/seg_raw"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/seg_raw_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Raw output"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/seg_raw_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lip reader only"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/use_or_desc"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/openrouter_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <EditText
                        android:id="@+id/api_key"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="OpenRouter API key"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingEnd="64dp" />

                    <TextView
                        android:id="@+id/key_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:text="Show"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </FrameLayout>

                <EditText
                    android:id="@+id/model_name"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Model"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textUri"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/check_key"
                        style="@style/Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check key" />

                    <TextView
                        android:id="@+id/check_status"
                        style="@style/Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="14dp"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Get a free key at openrouter.ai/keys. The default model is small and fast — swap it in the box above if you prefer another. "
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/raw_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="Without cleanup the lip reader is inaccurate and unreliable. Expect garbled, missing and wrong words."
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ================== LIP MODEL ================== -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Lip model" />

        <LinearLayout
            android:id="@+id/model_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/model_status"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/model_detail"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/model_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/model_download"
                    style="@style/Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Download" />

                <Button
                    android:id="@+id/model_remove"
                    style="@style/Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/model_import"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Use your own model (.zip)"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/model_source"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reads English from video alone, so use good light and face the camera. Hold for as long as you like; long dictation is read in pieces, split at your pauses. The model is Auto-AVSR’s LRS3 lip reader, licensed for research and non-commercial use only."
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================== PRIVACY ================== -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Privacy" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="The camera is on only while the dictation page is open, and frames are kept only while you hold the button. Lip reading happens on the device. With OpenRouter cleanup on, the raw transcript and a short tail of the text before your cursor are sent to openrouter.ai — never from password fields. Nothing you type is stored." />
    </LinearLayout>
</ScrollView>
